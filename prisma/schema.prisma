generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum ClassStatus {
  ACTIVE
  COMPLETED
}

enum LessonType {
  VIDEO
  H5P_VIDEO
  QUIZ
  ASSIGNMENT
  PRESENTATION
  DOCUMENT
  READING
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  REVIEWED
  LATE
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  ESSAY
  FILL_IN_BLANK
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STUDENT)
  bio          String?
  location     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coursesTaught   Course[]         @relation("CourseInstructor")
  enrollments     Enrollment[]
  lessonProgress  LessonProgress[]
  submissions     Submission[]
  announcements   Announcement[]
  classEnrollments ClassEnrollment[]
  classesLed      ClassRoom[]      @relation("ClassMentor")
  scheduleEvents  ScheduleEvent[]
  certificates    Certificate[]
  notifications   Notification[]
  quizzesCreated  Quiz[]           @relation("QuizCreator")
  quizSubmissions QuizSubmission[]
}

model Course {
  id           String   @id @default(cuid())
  title        String
  description  String?
  coverImage   String
  rating       Float    @default(0)
  instructorId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructor    User           @relation("CourseInstructor", fields: [instructorId], references: [id])
  modules       Module[]
  enrollments   Enrollment[]
  assignments   Assignment[]
  classRooms    ClassRoom[]
  announcements Announcement[]
  quizzes       Quiz[]
}

model Module {
  id       String @id @default(cuid())
  courseId String
  title    String
  order    Int

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id       String     @id @default(cuid())
  moduleId String
  title    String
  type     LessonType @default(VIDEO)
  content  String?
  fileUrl  String?
  duration String?
  order    Int

  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([moduleId])
}

model Enrollment {
  id              String @id @default(cuid())
  userId          String
  courseId        String
  progressPercent Int    @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model ClassRoom {
  id       String      @id @default(cuid())
  courseId String
  name     String
  code     String      @unique
  status   ClassStatus @default(ACTIVE)
  mentorId String?

  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  mentor      User?             @relation("ClassMentor", fields: [mentorId], references: [id])
  enrollments ClassEnrollment[]

  @@index([courseId])
}

model ClassEnrollment {
  id      String @id @default(cuid())
  classId String
  userId  String

  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
}

model Assignment {
  id               String   @id @default(cuid())
  courseId         String
  title            String
  description      String
  deadline         DateTime
  maxSizeMb        Int      @default(25)
  allowedFileTypes String   @default("PDF, ZIP")
  createdAt        DateTime @default(now())

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([courseId])
}

model Submission {
  id         String           @id @default(cuid())
  assignmentId String
  userId     String
  fileName   String?
  fileUrl    String?
  status     SubmissionStatus @default(NOT_SUBMITTED)
  grade      Int?
  submittedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
}

model Announcement {
  id        String   @id @default(cuid())
  courseId  String?
  authorId  String
  title     String
  body      String
  createdAt DateTime @default(now())

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  author User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model ScheduleEvent {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  startAt   DateTime
  endAt     DateTime
  color     String   @default("#6366f1")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Certificate {
  id        String   @id @default(cuid())
  userId    String
  title     String
  issuedAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Quiz {
  id          String     @id @default(cuid())
  courseId    String
  creatorId   String
  title       String
  description String?
  timeLimit   Int?       // in minutes, null = no limit
  dueDate     DateTime?
  totalPoints Int        @default(0)
  status      QuizStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator     User             @relation("QuizCreator", fields: [creatorId], references: [id])
  questions   QuizQuestion[]
  submissions QuizSubmission[]

  @@index([courseId])
  @@index([creatorId])
}

model QuizQuestion {
  id           String       @id @default(cuid())
  quizId       String
  type         QuestionType
  questionText String
  points       Int          @default(1)
  order        Int
  correctAnswer String?     // For auto-graded questions (TF, Fill in blank, MC option ID)
  createdAt    DateTime     @default(now())

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]

  @@index([quizId])
}

model QuizOption {
  id         String   @id @default(cuid())
  questionId String
  optionText String
  order      Int
  createdAt  DateTime @default(now())

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizSubmission {
  id          String    @id @default(cuid())
  quizId      String
  userId      String
  score       Int?      // null until graded
  totalPoints Int
  status      String    @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, GRADED
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  gradedAt    DateTime?

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@unique([quizId, userId])
  @@index([quizId])
  @@index([userId])
}

model QuizAnswer {
  id           String   @id @default(cuid())
  submissionId String
  questionId   String
  answerText   String?  // For essay, fill in blank, or selected option ID for MC
  isCorrect    Boolean? // null for essay (needs manual grading)
  pointsEarned Int?
  feedback     String?  // Mentor feedback for essay
  createdAt    DateTime @default(now())

  submission QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([submissionId])
  @@index([questionId])
}
